metabolite_names1 <- c("sT antigen", "MGlcn116", "MGlcn187",
"MGlcn190", "H2S", "NANA", "MGlcn191", "MGlcn186",
"GlcNAc", "Citrate", "Methionine", "MGlcn153"
, "Galactosamine", "2,6-DAP", "Deoxyguanosine")
top10_MEShealthy_bar <- ggplot(top10_MES_healthy,
