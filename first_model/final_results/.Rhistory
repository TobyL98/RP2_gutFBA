layout <- matrix(c(1, 1,
2, 3,
2, 3),
nrow = 3,
byrow = TRUE)
plot <- grid.arrange(density_plot,
top10_MESCRC_bar,
top10_MEShealthy_bar,
layout_matrix = layout,
bottom = textGrob("MES Difference", gp = gpar(fontsize = 20)))
